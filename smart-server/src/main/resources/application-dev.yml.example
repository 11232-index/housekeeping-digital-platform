# =============================================================
# 配置示例（无真实密钥）
# 用法：复制本文件并改名为 application-dev.yml，填入你自己的
#      数据库密码 / 阿里云OSS密钥 / 微信小程序密钥 后即可运行。
# application-dev.yml 已被 .gitignore 忽略，不会上传到 Git。
# =============================================================
spring:
  rabbitmq:
    host: localhost          # RabbitMQ 地址（本机/虚拟机IP）
    port: 5672
    username: guest
    password: guest
    virtual-host: /

smart:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: smart_housekeeping_system
    username: root
    password: 你的MySQL密码
  alioss:
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: 你的阿里云AccessKeyId
    access-key-secret: 你的阿里云AccessKeySecret
    bucket-name: 你的OSS桶名
  redis:
    host: localhost
    port: 6379
    database: 10
  wechat:
    appid: 你的微信小程序AppId
    secret: 你的微信小程序Secret
