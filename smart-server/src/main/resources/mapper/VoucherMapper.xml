<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.smart.mapper.VoucherMapper">
    <update id="update" parameterType="com.smart.entity.Voucher">
        UPDATE tb_voucher
        <set>
            <if test="orderId != null">
                order_id = #{orderId},
            </if>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="subTitle != null">
                sub_title = #{subTitle},
            </if>
            <if test="rules != null">
                rules = #{rules},
            </if>
            <if test="payValue != null">
                pay_value = #{payValue},
            </if>
            <if test="actualValue != null">
                actual_value = #{actualValue},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="pageQuery" resultType="com.smart.entity.Voucher">
        SELECT id, order_id, title, sub_title, rules,
        pay_value, actual_value, type, status, create_time, update_time
        FROM tb_voucher
        <where>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
