.address-page{min-height:100vh;background:#f5f5f5;padding-bottom:140rpx}
.address-header{padding:30rpx;background:#1976d2;color:#fff;text-align:center}
.address-title{font-size:34rpx;font-weight:bold}
.address-content{padding:20rpx}
.address-card{margin:0 0 20rpx}
.addr-top{padding-bottom:20rpx;border-bottom:1rpx solid #f0f0f0}
.addr-detail{display:flex;align-items:flex-start;gap:10rpx;margin-bottom:14rpx}
.addr-tag{flex-shrink:0;margin-top:4rpx;padding:4rpx 12rpx;font-size:22rpx;border-radius:4rpx;background:#e3f2fd;color:#1976d2}
.addr-text{font-size:28rpx;color:#333;line-height:1.6;flex:1}
.addr-contact{display:flex;align-items:center;font-size:26rpx;color:#666}
.addr-gender{margin-left:12rpx;color:#999;font-size:24rpx}
.addr-phone{margin-left:20rpx;color:#333}
.addr-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:16rpx}
.default-label{display:flex;align-items:center;font-size:26rpx;color:#999}
.default-label radio{margin-right:6rpx}
.addr-actions{display:flex;gap:24rpx}
.action-btn{font-size:26rpx;color:#1976d2;padding:4rpx 0}
.action-btn.danger{color:#e94e3c}
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120rpx 0}
.empty-icon{width:160rpx;height:160rpx;margin-bottom:24rpx;opacity:0.4}
.empty-text{font-size:28rpx;color:#999}
.loading-tip{text-align:center;padding:20rpx;font-size:24rpx;color:#ccc}
.addr-footer{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx;background:#fff;box-shadow:0 -2rpx 10rpx rgba(0,0,0,0.05)}
.add-btn{width:100%;height:88rpx;line-height:88rpx;text-align:center;background:#1976d2;color:#fff;border-radius:44rpx;font-size:30rpx}
