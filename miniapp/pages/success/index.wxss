.success-page{min-height:100vh;background:#f5f5f5;display:flex;flex-direction:column;align-items:center}
.success-content{display:flex;flex-direction:column;align-items:center;padding-top:200rpx}
.success-icon{width:160rpx;height:160rpx;border-radius:50%;background:#4caf50;display:flex;align-items:center;justify-content:center;margin-bottom:40rpx}
.success-check{color:#fff;font-size:80rpx;font-weight:bold}
.success-title{font-size:40rpx;font-weight:bold;color:#333;margin-bottom:20rpx}
.success-eta{font-size:28rpx;color:#1976d2;margin-bottom:16rpx}
.success-desc{font-size:26rpx;color:#999;text-align:center;padding:0 60rpx}
.success-buttons{display:flex;gap:30rpx;margin-top:80rpx}
.success-btn{padding:20rpx 50rpx;border-radius:40rpx;font-size:28rpx}
.success-btn.primary{background:#1976d2;color:#fff}
.success-btn.outline{border:2rpx solid #1976d2;color:#1976d2;background:transparent}
