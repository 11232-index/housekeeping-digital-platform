.mv-page{min-height:100vh;background:#f5f5f5;padding:20rpx}

.mv-card{display:flex;align-items:stretch;background:#fff;border-radius:16rpx;margin-bottom:20rpx;overflow:hidden;position:relative}
.mv-left{width:200rpx;flex-shrink:0;background:#e94e3c;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30rpx 0}
.mv-discount{font-size:44rpx;font-weight:bold}
.mv-type{font-size:22rpx;margin-top:8rpx;opacity:.85}
.mv-right{flex:1;padding:24rpx;display:flex;flex-direction:column}
.mv-title{font-size:30rpx;font-weight:bold;color:#333}
.mv-sub{font-size:24rpx;color:#999;margin-top:6rpx}
.mv-rules{font-size:22rpx;color:#bbb;margin-top:6rpx}
.mv-time{font-size:22rpx;color:#bbb;margin-top:auto;padding-top:12rpx}

/* 已使用：整张卡置灰 */
.mv-card.mv-used .mv-left{background:#c8c9cc}
.mv-card.mv-used .mv-title{color:#999}
.mv-card.mv-used .mv-sub,
.mv-card.mv-used .mv-rules,
.mv-card.mv-used .mv-time{color:#c8c9cc}
.mv-used-tag{position:absolute;right:24rpx;top:24rpx;font-size:22rpx;color:#fff;background:#c8c9cc;padding:4rpx 16rpx;border-radius:20rpx}

.mv-loading{text-align:center;color:#999;font-size:28rpx;padding:120rpx 0}
.mv-empty{text-align:center;color:#999;font-size:28rpx;padding:120rpx 0}
