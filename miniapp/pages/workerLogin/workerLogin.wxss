.wlog-page{min-height:100vh;background:#f5f5f5;padding:40rpx 30rpx}
.wlog-header{display:flex;flex-direction:column;align-items:center;padding:40rpx 0 50rpx}
.wlog-logo{width:140rpx;height:140rpx;border-radius:50%;background:#fff;border:4rpx solid #e3e3e3;margin-bottom:24rpx}
.wlog-title{font-size:40rpx;font-weight:bold;color:#333}
.wlog-sub{font-size:26rpx;color:#999;margin-top:10rpx}
.wlog-card{background:#fff;border-radius:16rpx;padding:10rpx 30rpx;margin-bottom:40rpx}
.form-item{display:flex;align-items:center;padding:26rpx 0;border-bottom:1rpx solid #f5f5f5}
.form-label{width:120rpx;font-size:28rpx;color:#666;flex-shrink:0}
.form-input{flex:1;font-size:30rpx}
.wlog-btn{background:#1976d2;color:#fff;font-size:32rpx;border-radius:44rpx;height:88rpx;line-height:88rpx}
.wlog-btn::after{border:none}
.wlog-btn[disabled]{background:#90caf9}
.wlog-tip{font-size:24rpx;color:#999;text-align:center;margin-top:24rpx;line-height:1.6}
