.my-page{min-height:100vh;background:#f5f5f5;padding-bottom:130rpx}
.my-header{background:linear-gradient(135deg,#1976d2,#42a5f5);padding:60rpx 30rpx 40rpx;display:flex;flex-direction:column;align-items:center}
.user-avatar-wrap{width:140rpx;height:140rpx;border-radius:50%;overflow:hidden;border:4rpx solid rgba(255,255,255,.5);margin-bottom:20rpx}
.user-avatar{width:100%;height:100%}
.user-name{font-size:36rpx;font-weight:bold;color:#fff}
.user-phone{font-size:26rpx;color:rgba(255,255,255,.8);margin-top:8rpx}
.worker-entry{background:linear-gradient(135deg,#43a047,#66bb6a);margin:20rpx;border-radius:16rpx;padding:28rpx 24rpx;display:flex;align-items:center}
.worker-entry-icon{width:64rpx;height:64rpx;text-align:center;line-height:64rpx;font-size:40rpx;background:rgba(255,255,255,.25);border-radius:50%;margin-right:20rpx}
.worker-entry-info{flex:1}
.worker-entry-title{display:block;font-size:32rpx;font-weight:bold;color:#fff}
.worker-entry-sub{display:block;font-size:24rpx;color:rgba(255,255,255,.85);margin-top:6rpx}
.worker-entry-arrow{font-size:32rpx;color:rgba(255,255,255,.9)}
.my-menu{background:#fff;margin:20rpx;border-radius:16rpx;overflow:hidden}
.menu-item{display:flex;align-items:center;padding:30rpx 24rpx;border-bottom:1rpx solid #f5f5f5}
.menu-icon{width:44rpx;height:44rpx;text-align:center;line-height:44rpx;margin-right:16rpx;font-size:28rpx}
.menu-name{flex:1;font-size:28rpx;color:#333}
.menu-arrow{font-size:28rpx;color:#ccc}
.my-orders{padding:0 20rpx}
.orders-title{font-size:32rpx;font-weight:bold;color:#333;padding:20rpx 0 10rpx}
.orders-empty{text-align:center;color:#999;font-size:28rpx;padding:40rpx 0}

/* 订单卡片 */
.order-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
.oc-top{display:flex;align-items:center;padding-bottom:16rpx}
.oc-status-tag{font-size:22rpx;padding:4rpx 16rpx;border-radius:6rpx;margin-right:16rpx;flex-shrink:0}
.tag-warning{background:#fff3e0;color:#e65100}
.tag-primary{background:#e3f2fd;color:#1565c0}
.tag-info{background:#e8f5e9;color:#2e7d32}
.tag-success{background:#f3e5f5;color:#7b1fa2}
.tag-gray{background:#f5f5f5;color:#999}
.oc-number{font-size:26rpx;color:#666}
.oc-body{padding:20rpx 0;border-top:1rpx solid #f5f5f5;border-bottom:1rpx solid #f5f5f5}
.oc-body text{display:block;padding:6rpx 0}
.oc-name{font-size:30rpx;color:#333;font-weight:bold}
.oc-contact{font-size:26rpx;color:#666}
.oc-time{font-size:26rpx;color:#666}
.oc-amount{font-size:28rpx;color:#e94e3c;font-weight:bold;padding-bottom:0}
.oc-actions{display:flex;justify-content:flex-end;gap:16rpx;padding:16rpx 0 0}
.oc-btn{padding:12rpx 32rpx;border-radius:40rpx;font-size:26rpx}
.oc-btn-outline{border:2rpx solid #ddd;color:#666;background:#fff}
.oc-btn-primary{background:#1976d2;color:#fff}
