page {
  height: 100%;
  background: #f5f7fa;
}

.cs-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

/* 顶部客服信息 */
.cs-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef1f5;
}

.cs-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #1976d2;
  box-sizing: border-box;
  background: #fff;
  flex-shrink: 0;
}

.cs-header-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.cs-title-row {
  display: flex;
  align-items: center;
}

.cs-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2d3d;
}

.cs-badge {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #1976d2;
  background: #e3f2fd;
  border-radius: 8rpx;
}

.cs-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.cs-online {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #2e7d32;
  flex-shrink: 0;
}

.cs-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #2e7d32;
}

/* 消息列表 */
.cs-messages {
  flex: 1;
  height: 0;
  padding: 24rpx 20rpx 0;
  box-sizing: border-box;
}

.cs-msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.cs-msg-user {
  /* 用户消息：气泡在左、头像在右，整组靠右对齐。
     不能用 row-reverse：DOM 里头像是最后一项，反转后会被甩到左边。 */
  justify-content: flex-end;
}

.cs-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff;
  border: 1rpx solid #eef1f5;
}

.cs-msg-ai .cs-avatar {
  margin-right: 16rpx;
}

.cs-msg-user .cs-avatar {
  margin-left: 16rpx;
}

.cs-bubble-wrap {
  max-width: 74%;
  display: flex;
  flex-direction: column;
}

.cs-msg-user .cs-bubble-wrap {
  align-items: flex-end;
}

.cs-bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.cs-bubble-ai {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.06);
}

.cs-bubble-user {
  background: #1976d2;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.cs-text {
  white-space: pre-wrap;
}

.cs-agent {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9aa4b2;
}

/* 复杂路径：步骤进度 */
.cs-steps {
  margin-bottom: 10rpx;
  padding: 12rpx 18rpx;
  background: #eef4fb;
  border-radius: 14rpx;
}

.cs-step {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6b7f;
}

.cs-step + .cs-step {
  margin-top: 4rpx;
}

.cs-step-icon {
  width: 28rpx;
  flex-shrink: 0;
  text-align: center;
  color: #8a94a6;
}

.cs-step-title {
  flex: 1;
  word-break: break-word;
}

.cs-step-running .cs-step-icon,
.cs-step-running .cs-step-title {
  color: #1976d2;
}

.cs-step-done .cs-step-icon {
  color: #2e7d32;
}

.cs-step-error .cs-step-icon,
.cs-step-error .cs-step-title {
  color: #d9534f;
}

/* 等待动画 */
.cs-typing {
  display: flex;
  align-items: center;
  height: 36rpx;
}

.cs-typing text {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #1976d2;
  opacity: 0.35;
  animation: cs-blink 1.2s infinite;
}

.cs-typing text:nth-child(2) {
  animation-delay: 0.2s;
}

.cs-typing text:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes cs-blink {
  0%, 80%, 100% {
    opacity: 0.2;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

.cs-bottom-space {
  height: 24rpx;
}

/* 首次进入的快捷问题 */
.cs-quick {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 20rpx 16rpx;
  background: #f5f7fa;
}

.cs-quick-item {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #1976d2;
  background: #fff;
  border: 1rpx solid #cfe4fb;
  border-radius: 28rpx;
}

.cs-quick-item:active {
  background: #e3f2fd;
}

/* 底部输入栏 */
.cs-input-bar {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef1f5;
}

.cs-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.cs-placeholder {
  color: #a8b0bd;
}

.cs-send {
  margin-left: 16rpx;
  min-width: 108rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #1976d2;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.cs-send-disabled {
  background: #b9c6d6;
}
