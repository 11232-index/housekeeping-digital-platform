.pay-page{min-height:100vh;background:#f5f5f5;padding-bottom:120rpx}
.pay-content{padding:20rpx}
.amount-card{text-align:center;padding:40rpx}
.amount-label{font-size:28rpx;color:#999}
.amount-value{margin:20rpx 0}
.amount-symbol{font-size:36rpx;color:#e94e3c}
.amount-num{font-size:72rpx;font-weight:bold;color:#e94e3c}
.countdown{font-size:26rpx;color:#e94e3c;margin-top:20rpx}
.pay-methods{margin-top:20rpx;padding:24rpx}
.method-row{margin-bottom:16rpx}
.method-label{font-size:30rpx;font-weight:bold;color:#333}
.method-item{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #f5f5f5}
.method-item:last-child{border-bottom:none}
.method-name{font-size:28rpx;color:#333}
.method-radio{width:36rpx;height:36rpx;border:3rpx solid #ddd;border-radius:6rpx;display:flex;align-items:center;justify-content:center}
.method-radio.checked{border-color:#1976d2;background:#1976d2}
.method-radio.checked::after{content:'✓';color:#fff;font-size:24rpx}
.pay-footer{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx;background:#fff}
.pay-btn{width:100%;height:88rpx;line-height:88rpx;text-align:center;background:#1976d2;color:#fff;border-radius:44rpx;font-size:32rpx;font-weight:bold}
.pay-btn.disabled{opacity:.5}
