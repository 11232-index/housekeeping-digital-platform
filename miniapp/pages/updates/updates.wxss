.updates-page{min-height:100vh;background:#f5f5f5;padding-bottom:20rpx}

.search-bar{padding:16rpx 20rpx;background:#fff}
.search-input-wrap{display:flex;align-items:center;background:#f5f5f5;border-radius:32rpx;padding:12rpx 20rpx}
.search-icon{margin-right:10rpx;opacity:.4}
.search-input{flex:1;font-size:26rpx;line-height:36rpx}
.search-clear{font-size:32rpx;color:#999;line-height:1;margin-left:8rpx;padding:4rpx}

.search-history{background:#fff;padding:0 20rpx 20rpx}
.history-header{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0 10rpx}
.history-title{font-size:26rpx;color:#999}
.history-clear{width:32rpx;height:32rpx;display:flex;align-items:center;justify-content:center}
.history-clear-icon{font-size:24rpx;color:#bbb;line-height:1;padding:4rpx}
.history-list{display:flex;flex-wrap:wrap;gap:16rpx}
.history-item{padding:10rpx 24rpx;background:#f5f5f5;border-radius:24rpx}
.history-keyword{font-size:24rpx;color:#666}

.updates-list{padding:16rpx 20rpx}

.update-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
.card-title{font-size:32rpx;font-weight:bold;color:#333;margin-bottom:16rpx}
.card-body{display:flex;gap:16rpx;margin-bottom:16rpx}
.card-img{width:200rpx;height:200rpx;border-radius:8rpx;flex-shrink:0}
.card-img-empty{background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#ccc}
.card-content{flex:1;font-size:26rpx;color:#666;line-height:1.6;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:5;word-break:break-all}
.card-time{font-size:24rpx;color:#999;text-align:right}

.load-more,.no-more,.empty-tip,.loading-tip{text-align:center;padding:30rpx;font-size:26rpx;color:#999}
.load-more{color:#1976d2}
