.page{min-height:100vh;background:#f5f5f5}
.tab-bar{width:100%;white-space:nowrap;background:#fff;border-bottom:1rpx solid #e0e0e0}
.tab-list{display:inline-flex;padding:0 20rpx}
.tab-item{padding:24rpx 28rpx;flex-shrink:0;border-bottom:4rpx solid transparent}
.tab-item.active{border-bottom-color:#1976d2}
.tab-text{font-size:28rpx;color:#666}
.tab-item.active .tab-text{color:#1976d2;font-weight:bold}
.content-box{background:#fff;margin:20rpx;border-radius:16rpx;padding:32rpx 28rpx}
.content-title{font-size:36rpx;font-weight:bold;color:#333;margin-bottom:30rpx}
.content-text{font-size:30rpx;color:#333;line-height:1.8;white-space:pre-wrap;word-break:break-all}
.loading-tip{text-align:center;padding:100rpx;color:#999;font-size:28rpx}
