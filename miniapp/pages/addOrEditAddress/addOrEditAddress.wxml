<view class="aoea-page">

  <!-- 表单区域 -->
  <view class="aoea-form">
    <!-- 性别 + 联系人 -->
    <view class="form-item">
      <text class="form-label">联系人</text>
      <view class="opt-row">
        <text wx:for="{{genders}}" wx:key="value"
              class="opt-item {{form.sex === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="selectGender">{{item.name}}</text>
      </view>
      <input class="form-input" placeholder="请输入姓名" value="{{form.consignee}}"
             data-field="consignee" bindinput="onInput"/>
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11"
             value="{{form.phone}}" data-field="phone" bindinput="onInput"/>
    </view>

    <!-- 省市区 -->
    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="region-picker {{region[0] ? '' : 'placeholder'}}">
          {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、门牌号等" maxlength="200"
                value="{{form.detail}}" data-field="detail" bindinput="onInput"></textarea>
    </view>

    <!-- 标签 -->
    <view class="form-item" style="border-bottom:none">
      <text class="form-label">标签</text>
      <view class="opt-row">
        <text wx:for="{{labels}}" wx:key="value"
              class="opt-item {{form.label === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="selectLabel">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="aoea-footer">
    <button class="save-btn" bindtap="saveAddress" loading="{{submitting}}">保存</button>
    <button wx:if="{{isEdit}}" class="delete-btn" bindtap="deleteAddress">删除地址</button>
  </view>
</view>
