.aoea-page{min-height:100vh;background:#f5f5f5;padding-bottom:40rpx}
.aoea-header{display:flex;align-items:center;justify-content:space-between;padding:20rpx 30rpx;background:#1976d2;color:#fff}
.aoea-title{font-size:34rpx;font-weight:bold}
.back-btn{font-size:28rpx;padding:10rpx 0}
.aoea-form{background:#fff;margin:20rpx;border-radius:16rpx;padding:24rpx 30rpx}
.form-item{padding:22rpx 0;border-bottom:1rpx solid #f5f5f5}
.form-label{font-size:28rpx;color:#333;font-weight:bold;margin-bottom:14rpx;display:block}
.form-input{width:100%;height:76rpx;line-height:76rpx;border:1rpx solid #e0e0e0;border-radius:8rpx;padding:0 18rpx;font-size:28rpx;box-sizing:border-box}
.form-textarea{width:100%;height:140rpx;border:1rpx solid #e0e0e0;border-radius:8rpx;padding:16rpx 18rpx;font-size:28rpx;box-sizing:border-box}
.opt-row{display:flex;gap:16rpx;margin-bottom:14rpx}
.opt-item{padding:12rpx 28rpx;border:1rpx solid #e0e0e0;border-radius:8rpx;font-size:26rpx;color:#666;transition:all 0.2s}
.opt-item.active{border-color:#1976d2;color:#1976d2;background:#e3f2fd}
.region-picker{width:100%;height:76rpx;line-height:76rpx;border:1rpx solid #e0e0e0;border-radius:8rpx;padding:0 18rpx;font-size:28rpx;color:#333;box-sizing:border-box}
.region-picker.placeholder{color:#999}
.aoea-footer{padding:30rpx 20rpx 40rpx}
.save-btn{width:100%;height:88rpx;line-height:88rpx;background:#1976d2;color:#fff;border-radius:44rpx;font-size:30rpx;margin-bottom:20rpx;border:none}
.save-btn::after{border:none}
.delete-btn{width:100%;height:88rpx;line-height:88rpx;background:#fff;color:#e94e3c;border:2rpx solid #e94e3c;border-radius:44rpx;font-size:30rpx}
.delete-btn::after{border:none}
