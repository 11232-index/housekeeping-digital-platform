.cart-page{min-height:100vh;background:#f5f5f5;display:flex;flex-direction:column;padding-bottom:130rpx}
.cart-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:200rpx}
.cart-empty-icon{width:120rpx;height:120rpx;opacity:.3;margin-bottom:30rpx}
.cart-empty-text{font-size:30rpx;color:#999;margin-bottom:12rpx}
.cart-empty-tip{font-size:26rpx;color:#bbb}
.cart-header{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx;background:#fff;border-bottom:1rpx solid #f0f0f0}
.cart-header-title{font-size:28rpx;color:#666}
.cart-clear{display:flex;align-items:center;gap:6rpx;font-size:28rpx;color:#999}
.clear-icon{width:28rpx;height:28rpx}
.cart-list{flex:1;padding:16rpx 0}
.cart-item{display:flex;align-items:center;padding:20rpx 32rpx;background:#fff;border-bottom:1rpx solid #f5f5f5}
.cart-item-image{width:100rpx;height:100rpx;border-radius:8rpx;flex-shrink:0}
.cart-item-info{flex:1;margin-left:16rpx;height:100rpx;display:flex;flex-direction:column;justify-content:center}
.cart-item-name{font-size:28rpx;color:#333}
.cart-item-price{font-size:26rpx;color:#e94e3c;margin-top:6rpx}
.cart-item-action{display:flex;align-items:center;flex-shrink:0}
.action-btn.danger{font-size:28rpx;color:#e94e3c}
.cart-item-arrow{font-size:28rpx;color:#ccc;margin-left:8rpx}
.cart-placeholder{height:200rpx}
.cart-bottom{position:fixed;bottom:100rpx;left:0;right:0;height:100rpx;background:#333;display:flex;align-items:center;padding:0 32rpx}
.cart-bottom-price{flex:1;color:#fff}
.cart-bottom-price .price-label{font-size:28rpx}
.cart-bottom-price .price-symbol{font-size:24rpx}
.cart-bottom-price .price-value{font-size:40rpx;font-weight:bold}
.cart-bottom-btn{padding:16rpx 40rpx;background:#555;color:#999;border-radius:40rpx;font-size:28rpx}
.cart-bottom-btn.active{background:#1976d2;color:#fff}
.cart-bottom-btn.disabled{background:#555;color:#999}
