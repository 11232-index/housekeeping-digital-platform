.appointment-page{min-height:100vh;background:#f5f5f5;padding:20rpx 20rpx 160rpx}
/* 第一个盒子：家政员信息 */
.hk-card{display:flex;align-items:center;background:#fff;border-radius:16rpx;padding:24rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06)}
.hk-avatar{width:100rpx;height:100rpx;border-radius:12rpx;flex-shrink:0}
.hk-avatar-empty{background:#f0f0f0}
.hk-name{flex:1;font-size:30rpx;font-weight:bold;color:#333;margin-left:20rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hk-rating{display:flex;align-items:baseline;flex-shrink:0}
.rating-num{font-size:36rpx;color:#f5a623;font-weight:bold}
.rating-none{font-size:28rpx;color:#bbb}
.rating-label{font-size:22rpx;color:#999;margin-left:4rpx}
/* 第二个盒子：预约时间选择 */
.schedule-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-top:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06)}
.schedule-title{font-size:28rpx;font-weight:bold;color:#333;margin-bottom:16rpx}
.schedule-item{display:flex;align-items:center;padding:20rpx 16rpx;border:2rpx solid #e8e8e8;border-radius:12rpx;margin-bottom:12rpx}
.schedule-item.selected{border-color:#1976d2;background:#e3f2fd}
.schedule-date{font-size:28rpx;color:#333;flex:1}
.schedule-time{font-size:26rpx;color:#666}
.check-mark{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;background:#1976d2;color:#fff;border-radius:50%;font-size:24rpx;margin-left:16rpx}
.empty-slot{text-align:center;padding:60rpx;color:#999;font-size:28rpx}
.appointment-footer{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx 40rpx;background:linear-gradient(transparent,#f5f5f5 40%);z-index:100}
.footer-btn{width:100%;height:88rpx;line-height:88rpx;text-align:center;background:#1976d2;color:#fff;font-size:32rpx;border-radius:44rpx}
