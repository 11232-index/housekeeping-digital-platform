.details-page{min-height:100vh;background:#f5f5f5}
.details-content{padding:20rpx;padding-bottom:40rpx}
.status-card{text-align:center}
.status-title{font-size:36rpx;font-weight:bold;color:#333;margin-bottom:10rpx}
.status-time{font-size:26rpx;color:#e94e3c;margin-bottom:20rpx}
.status-actions{display:flex;justify-content:center;gap:20rpx;margin-top:20rpx}
.status-actions .btn{height:60rpx;padding:0 30rpx;font-size:26rpx}
.shop-name{font-size:30rpx;font-weight:bold;color:#333;padding-bottom:20rpx;border-bottom:1rpx solid #f0f0f0}
.detail-item{padding:20rpx 0;border-bottom:1rpx solid #f5f5f5}
.detail-item:last-child{border-bottom:none}
.item-row{display:flex;align-items:center}
.item-image{width:100rpx;height:100rpx;border-radius:8rpx;flex-shrink:0}
.item-info{flex:1;margin-left:16rpx;display:flex;flex-direction:column;justify-content:center;gap:16rpx}
.item-name{font-size:28rpx;color:#333}
.item-bottom{display:flex;justify-content:space-between}
.item-price{color:#e94e3c;font-weight:bold;font-size:28rpx}
.item-req-list{margin-top:16rpx;padding-top:14rpx;border-top:1rpx dashed #e8e8e8}
.item-req-row{display:flex;padding:4rpx 0;font-size:24rpx;color:#888}
.item-req-name{flex-shrink:0}
.item-req-val{color:#666}
.order-summary{padding-top:20rpx;border-top:1rpx solid #f0f0f0;margin-top:10rpx}
.summary-row{display:flex;justify-content:space-between;font-size:30rpx;font-weight:bold}
.summary-price{color:#e94e3c}
.info-row{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5;font-size:26rpx}
.info-label{color:#999;min-width:160rpx}
.contact-card{text-align:center;color:#1976d2;font-size:30rpx}
