.detail-page{min-height:100vh;background:#f5f5f5;padding:20rpx}
.detail-top{display:flex;align-items:center;margin-bottom:20rpx;padding:10rpx 0}
.back-arrow{font-size:36rpx;color:#1976d2;margin-right:8rpx;font-weight:bold}
.back-text{font-size:28rpx;color:#1976d2}
.detail-card{background:#fff;border-radius:16rpx;padding:32rpx 28rpx}
.detail-title{font-size:40rpx;font-weight:bold;color:#333;margin-bottom:30rpx}
.detail-meta{font-size:24rpx;color:#999;margin-bottom:30rpx}
.detail-content{font-size:30rpx;color:#333;line-height:1.8;white-space:pre-wrap;word-break:break-all;overflow-wrap:break-word}
.loading-tip{text-align:center;padding:100rpx;color:#999;font-size:28rpx}
