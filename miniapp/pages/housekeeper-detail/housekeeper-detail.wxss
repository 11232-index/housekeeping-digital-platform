.detail-page{min-height:100vh;background:#f5f5f5;padding-bottom:160rpx}
.carousel-section{width:100%;height:400rpx;border-radius:0 0 24rpx 24rpx;overflow:hidden}
.carousel-swiper{width:100%;height:100%}
.carousel-img{width:100%;height:100%}
/* 家政员信息卡片 */
.info-card{width:100%;background:#fff;border-radius:0 0 24rpx 24rpx;overflow:hidden;box-shadow:0 4rpx 20rpx rgba(0,0,0,0.08)}
/* 上盒子：头像 + 名字/评分/rank + 单价 */
.info-card-top{display:flex;align-items:flex-start;padding:24rpx 24rpx 20rpx}
/* 第1部分：头像 */
.info-avatar{width:120rpx;height:120rpx;border-radius:16rpx;flex-shrink:0}
.info-avatar-empty{background:#f0f0f0}
/* 第2部分：名字 + 星星 + rank */
.info-main{flex:1;height:120rpx;margin-left:20rpx;display:flex;flex-direction:column;justify-content:space-between;min-width:0}
.info-name{font-size:32rpx;font-weight:bold;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.info-stars-row{display:flex;align-items:center}
.info-stars{position:relative;display:inline-block;font-size:24rpx;letter-spacing:2rpx;white-space:nowrap}
.info-stars-empty{color:#ddd}
.info-stars-fill{color:#f5a623;position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap}
.info-rating-num{font-size:24rpx;color:#f5a623;font-weight:bold;margin-left:8rpx}
.info-no-rating{font-size:22rpx;color:#bbb}
.info-rank{display:flex}
.info-rank-tag{padding:4rpx 16rpx;border-radius:20rpx;font-size:22rpx;white-space:nowrap}
.info-rank-tag.rank-gold{background:#fff8e1;color:#f59e00;border:1rpx solid #f59e00}
.info-rank-tag.rank-silver{background:#f5f5f5;color:#888;border:1rpx solid #bbb}
.info-rank-tag.rank-bronze{background:#fdf2e9;color:#b87333;border:1rpx solid #b87333}
/* 第4部分：单价 */
.info-price-wrap{flex-shrink:0;margin-left:20rpx;display:flex;align-items:baseline}
.info-price-symbol{font-size:24rpx;color:#e94e3c;font-weight:bold}
.info-price-value{font-size:36rpx;color:#e94e3c;font-weight:bold}
.info-price-unit{font-size:22rpx;color:#e94e3c}
/* 下盒子 */
.info-card-bottom{padding:0 24rpx 24rpx}
.employee-info{display:flex;justify-content:space-between;align-items:center}
.employee-info-item{font-size:26rpx;color:#666}

.loading-tip{text-align:center;padding:100rpx;color:#999;font-size:28rpx}
/* 综合评价卡片 */
.review-card{width:100%;background:#fff;border-radius:0 0 24rpx 24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,0.08);margin-top:20rpx;padding:24rpx;box-sizing:border-box;overflow:hidden}
.review-title{font-size:28rpx;font-weight:bold;color:#333;margin-bottom:16rpx}
.review-content{font-size:26rpx;color:#666;line-height:1.6;white-space:pre-wrap;word-break:break-all}
/* 底部预约按钮 */
.bottom-bar{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx 40rpx;background:linear-gradient(transparent,#f5f5f5 40%);z-index:100}
.btn-book-now{width:100%;height:88rpx;line-height:88rpx;text-align:center;background:#e94e3c;color:#fff;font-size:32rpx;border-radius:44rpx}
