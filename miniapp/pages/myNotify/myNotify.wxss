.mn-page{min-height:100vh;background:#f5f5f5;padding:20rpx}

.mn-head{display:flex;justify-content:space-between;align-items:center;padding:10rpx 8rpx 20rpx}
.mn-head-tip{font-size:24rpx;color:#999}
.mn-head-btn{font-size:26rpx;color:#1976d2}

.mn-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
/* 未读：左侧一条蓝边 + 浅蓝底，扫一眼就能区分 */
.mn-card.unread{background:#eaf4ff;border-left:6rpx solid #1976d2}
.mn-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx}
.mn-title{font-size:28rpx;font-weight:bold;color:#333;flex:1;margin-right:12rpx}
.mn-card.unread .mn-title{color:#1976d2}
.mn-time{font-size:22rpx;color:#bbb;flex-shrink:0}
.mn-content{font-size:26rpx;color:#666;line-height:40rpx;word-break:break-all}

.mn-loading{text-align:center;color:#999;font-size:28rpx;padding:120rpx 0}
.mn-empty{text-align:center;color:#999;font-size:28rpx;padding:120rpx 0}
